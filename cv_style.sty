\ProvidesPackage{cv_style}[2026/10/27 Custom CV/Resume Style Package]

% --- Pacchetti base e codifica ---
\RequirePackage[utf8]{inputenc}
\RequirePackage[T1]{fontenc}
\RequirePackage{etoolbox}
\RequirePackage[italian,english]{babel}
\RequirePackage{lmodern}

% Imposta la lingua di babel in base a \cvlang (default: it)
\makeatletter
\@ifundefined{cvlang}{\newcommand{\cvlang}{it}}{}
\makeatother
\ifdefstring{\cvlang}{en}{
  \AtBeginDocument{\selectlanguage{english}}
}{
  \AtBeginDocument{\selectlanguage{italian}}
}

% --- Font icone e simboli ---
\RequirePackage{fontawesome5}
\RequirePackage{latexsym}
\RequirePackage{graphicx}
\RequirePackage{tikz}

% --- Foto profilo (supporta assets/profile.jpg, profile.png, profile.jpeg o placeholder) ---
\newcommand{\profilephoto}{%
  \IfFileExists{assets/profile.jpg}{%
    \begin{tikzpicture}[baseline=(current bounding box.center)]
      \clip[rounded corners=3pt] (0,0) rectangle (1.7cm, 2.1cm);
      \node[inner sep=0pt] at (0.85cm, 1.05cm) {\includegraphics[height=2.1cm, keepaspectratio]{assets/profile.jpg}};
      \draw[gray!35, rounded corners=3pt, line width=0.4pt] (0,0) rectangle (1.7cm, 2.1cm);
    \end{tikzpicture}%
  }{%
    \IfFileExists{assets/profile.png}{%
      \begin{tikzpicture}[baseline=(current bounding box.center)]
        \clip[rounded corners=3pt] (0,0) rectangle (1.7cm, 2.1cm);
        \node[inner sep=0pt] at (0.85cm, 1.05cm) {\includegraphics[height=2.1cm, keepaspectratio]{assets/profile.png}};
        \draw[gray!35, rounded corners=3pt, line width=0.4pt] (0,0) rectangle (1.7cm, 2.1cm);
      \end{tikzpicture}%
    }{%
      \IfFileExists{assets/profile.jpeg}{%
        \begin{tikzpicture}[baseline=(current bounding box.center)]
          \clip[rounded corners=3pt] (0,0) rectangle (1.7cm, 2.1cm);
          \node[inner sep=0pt] at (0.85cm, 1.05cm) {\includegraphics[height=2.1cm, keepaspectratio]{assets/profile.jpeg}};
          \draw[gray!35, rounded corners=3pt, line width=0.4pt] (0,0) rectangle (1.7cm, 2.1cm);
        \end{tikzpicture}%
      }{%
        \begin{tikzpicture}[baseline=(current bounding box.center)]
          \fill[gray!10, rounded corners=3pt] (0,0) rectangle (1.7cm, 2.1cm);
          \draw[gray!35, rounded corners=3pt, line width=0.4pt] (0,0) rectangle (1.7cm, 2.1cm);
          \node[gray!50] at (0.85cm, 1.05cm) {\Large\faUser};
        \end{tikzpicture}%
      }%
    }%
  }%
}

% --- Layout e margini di pagina ---
\RequirePackage[a4paper, left=0.55in, right=0.55in, top=0.45in, bottom=0.45in]{geometry}
\RequirePackage{fancyhdr}
\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0pt}
\renewcommand{\footrulewidth}{0pt}

% --- Formattazione sezioni ---
\RequirePackage{titlesec}
\titleformat{\section}{
  \scshape\raggedright\large
}{}{0em}{}[\vspace{1pt}\color{black}\titlerule\vspace{3pt}]
\titlespacing*{\section}{0pt}{8pt}{2pt}

% --- Elenchi puntati e spaziatura ---
\RequirePackage{enumitem}
\setlist[itemize]{leftmargin=0.15in, label=\textbullet, nosep}

% --- Tabelle e colonne ---
\RequirePackage{tabularx}
\RequirePackage{multicol}

% --- Colori e link ipertestuali ---
\RequirePackage{xcolor}
\RequirePackage[hidelinks]{hyperref}
\urlstyle{same}

% --- Supporto ATS (Machine-Readable PDF) ---
\input{glyphtounicode}
\pdfgentounicode=1

% --- Macro personalizzate per CV (Layout fluido senza elenchi puntati) ---

% Intestazione sottosezione (Es. Titolo di lavoro / Titolo di studio)
\newcommand{\resumeSubheading}[4]{
  \vspace{3pt}\noindent
  \begin{tabular*}{\linewidth}{@{}l@{\extracolsep{\fill}}r@{}}
    \textbf{#1} & \textbf{\small #2} \\
    \textit{\small #3} & \textit{\small #4} \\
  \end{tabular*}\par\vspace{1.5pt}
}

% Intestazione per progetti o premi
\newcommand{\resumeProjectHeading}[2]{
  \vspace{3pt}\noindent
  \begin{tabular*}{\linewidth}{@{}l@{\extracolsep{\fill}}r@{}}
    #1 & \textit{\small #2} \\
  \end{tabular*}\par\vspace{1.5pt}
}

% Descrizione narrativa testuale (senza punti elenco)
\newcommand{\resumeDesc}[1]{
  \noindent\small{#1}\par\vspace{3pt}
}

% Contenitori di sezione (mantenuti per modularità e spaziatura)
\newcommand{\resumeSubHeadingListStart}{\vspace{1pt}}
\newcommand{\resumeSubHeadingListEnd}{\vspace{2pt}}

\newcommand{\resumeItemListStart}{\begin{itemize}[leftmargin=0.18in, label=\textbullet, nosep, itemsep=1.5pt, topsep=1.5pt, partopsep=0pt]}
\newcommand{\resumeItemListEnd}{\end{itemize}\vspace{2pt}}

\newcommand{\resumeItem}[1]{
  \item\small{#1}
}
